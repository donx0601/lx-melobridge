# Copy this file to .env. Never commit .env.
# A public domain name or a dedicated public IPv4 address.
PUBLIC_HOST=music.example.com
GATEWAY_USER=change-this-user
GATEWAY_PASSWORD=replace-with-a-long-random-password
ADMIN_USER=change-this-admin
ADMIN_PASSWORD=replace-with-another-long-random-password
RESOLVER_TOKEN=replace-with-a-long-random-token
ACTIVE_SOURCE=
AUTO_SCRIPT_FALLBACK=false
FALLBACK_SOURCES=
SOURCE_ATTEMPT_TIMEOUT_MS=20000
APP_UID=1000
APP_GID=1000
